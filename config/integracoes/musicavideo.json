{
  "manifesto": 1,
  "rota": "fluxo",
  "command": "musicavideo",
  "repo": {
    "url": "https://github.com/inematds/musicavideo",
    "commit": "24e46d8",
    "pasta": "musicavideo"
  },
  "requer": {
    "bin": [
      "python3",
      "ffmpeg"
    ],
    "chaves": [
      "KIE_API_KEY",
      "AGNES_API_KEY"
    ],
    "fontes": []
  },
  "descricao": "Uma frase vira música + capa + clipe, planejados juntos e executados em fases com portão de aprovação.",
  "exemplo": "/musicavideo balada pop sobre recomeço",
  "definicao": {
    "flow": {
      "nome": "musicavideo",
      "prefixo": "MVD",
      "versao_def": 1,
      "alvos": {
        "unico": {
          "canal": "lives10",
          "gatilho": "usuário pede uma música com capa e clipe a partir de uma frase"
        }
      },
      "fases": [
        {
          "id": "plano",
          "escopo": "fluxo",
          "fila": "texto",
          "kind": "function",
          "tarefa": "cli.rodar",
          "max_tentativas": 2,
          "pausa_apos": true,
          "portao": {
            "mostrar": [
              "{{artefato:plano}}"
            ]
          },
          "comando": "bash {{repo}}/musicavideo.sh plano {{input}} --bruto"
        },
        {
          "id": "musica",
          "escopo": "fluxo",
          "fila": "io",
          "kind": "function",
          "tarefa": "cli.rodar",
          "max_tentativas": 2,
          "pausa_apos": true,
          "portao": {
            "mostrar": [
              "{{artefato}}"
            ]
          },
          "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} musica --sim --sem-revisao --aprovar"
        },
        {
          "id": "capa-clipe",
          "escopo": "fluxo",
          "fila": "render",
          "kind": "function",
          "tarefa": "cli.rodar",
          "max_tentativas": 2,
          "pausa_apos": true,
          "portao": {
            "mostrar": [
              "{{artefato}}"
            ]
          },
          "comando": "bash {{repo}}/musicavideo.sh faz {{anterior:slug}} --sim --sem-revisao --aprovar"
        },
        {
          "id": "entrega",
          "escopo": "fluxo",
          "fila": "io",
          "kind": "function",
          "tarefa": "cli.rodar",
          "max_tentativas": 2,
          "pausa_apos": false,
          "comando": "bash {{repo}}/musicavideo.sh pacote {{anterior:slug}}"
        }
      ]
    },
    "prompts": {}
  },
  "gerado": {
    "em": "2026-08-20",
    "por": "claude",
    "confianca": {
      "definicao.flow.alvos": "chute",
      "definicao.flow.prefixo": "chute",
      "definicao.flow.fases": "chute",
      "requer.chaves": "lido",
      "requer.bin": "lido"
    }
  }
}
