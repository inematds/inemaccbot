# Copie para `.env` (chmod 600) e troque /CAMINHO/PARA pelo diretório do clone.
# O parser é minimalista: CHAVE=valor, `#` comenta, sem expansão de ~ ou $HOME.

# --- obrigatórias: sem uma delas o boot falha alto, antes de subir worker ---
BOT_TOKEN=
# Não sabe o id do seu chat? Deixe 0: é o modo pareamento, e o PRIMEIRO /ping
# que o bot receber cadastra aquele chat como dono e reescreve esta linha.
# Vazio NÃO é pareamento — vazio derruba o boot, de propósito.
ALLOWED_CHAT_IDS=0
QUEUE_DB=/CAMINHO/PARA/inemaccbot/inemaccbot.db
STATE_DIR=/CAMINHO/PARA/inemaccbot/state
LOG_FILE=/CAMINHO/PARA/inemaccbot/inemaccbot.log

# --- opcionais: o default vale se a linha ficar de fora ---
# Onde moram os repos de domínio (promoavatar, promoavatar3).
PROJETOS_DIR=/CAMINHO/PARA/projetos          # default: $HOME/projetos
# Pasta servida por HTTP e as bases de URL do link final (duas por causa da rede dupla).
PUBLICO_DIR=/CAMINHO/PARA/projetos/output/reels   # default: $HOME/projetos/output/reels
PUBLICO_URLS=

# Perfil de execução dos jobs de agente.
MOTOR_PADRAO=claude
MODELO_PADRAO=sonnet
ESFORCO_PADRAO=low

# HeyGen. As três linhas abaixo são CAMINHO, não segredo.
HEYGEN_CLI=heygen                            # default: heygen (precisa estar no PATH)
HEYGEN_ENV_PATH=/CAMINHO/PARA/projetos/openpcbotv2/.env   # default: $HOME/projetos/openpcbotv2/.env
HEYGEN_PERFIL_CHROME=/CAMINHO/PARA/perfil-heygen          # default: $HOME/.cache/inemaccbot/perfil-heygen

# A API key do HeyGen (rotas `| api` e `| creditos`) NÃO é lida deste arquivo por
# padrão: ela é lida, em runtime, do arquivo que o HEYGEN_ENV_PATH acima aponta —
# é assim que o segredo de terceiro fica no arquivo do dono dele, e não copiado
# por aqui. O código aceita QUALQUER arquivo com uma linha HEYGEN_API_KEY=.
#
# Numa máquina que não tem o openpcbotv2 (uma VPS, por exemplo), há dois caminhos:
#
#   1. arquivo só dela  — o recomendado, mantém segredo fora do .env do bot:
#        echo 'HEYGEN_API_KEY=hg_...' > ~/.config/inemaccbot/heygen.env
#        chmod 600 ~/.config/inemaccbot/heygen.env
#        HEYGEN_ENV_PATH=/root/.config/inemaccbot/heygen.env
#
#   2. aqui mesmo — aponte o HEYGEN_ENV_PATH para ESTE arquivo e descomente a
#      linha abaixo. Funciona sem mudar código, mas junta segredo e config num
#      arquivo só; se fizer isso, garanta o chmod 600 e nunca versione o .env.
#        HEYGEN_ENV_PATH=/CAMINHO/PARA/inemaccbot/.env
# HEYGEN_API_KEY=
